<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WebView2TestApp</RootNamespace>
    <AssemblyName>WebView2TestApp</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon />
    <StartupObject>WebView2TestApp.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Requires Microsoft Edge WebView2 Runtime installed on the machine.
      Download: https://developer.microsoft.com/en-us/microsoft-edge/webview2/
    -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
